{
  "report": {
    "title": "Ansible Automation Platform Node Metrics Report",
    "aap_url": "{{ metrics.aap_url }}",
    "generated_at": "{{ metrics.generated_at }}"
  },
{% if metrics.subscription_details is defined and metrics.subscription_details %}
  "subscription_details": {
    "status": "{{ metrics.subscription_details.status }}",
    "status_description": "{{ metrics.subscription_details.status_description }}",
    "hosts_remaining": {% if metrics.subscription_details.hosts_remaining is string %}"{{ metrics.subscription_details.hosts_remaining }}"{% else %}{{ metrics.subscription_details.hosts_remaining }}{% endif %},
    "subscription_type": "{{ metrics.subscription_details.subscription_type }}",
    "expires_on": "{{ metrics.subscription_details.expires_on }}",
    "automation_controller_version": "{{ metrics.subscription_details.automation_controller_version }}",
    "hosts_automated": "{{ metrics.subscription_details.hosts_automated }}",
    "hosts_deleted": {% if metrics.subscription_details.hosts_deleted is string %}"{{ metrics.subscription_details.hosts_deleted }}"{% else %}{{ metrics.subscription_details.hosts_deleted }}{% endif %},
    "subscription_sku": "{{ metrics.subscription_details.subscription_sku }}",
    "expires_on_utc": "{{ metrics.subscription_details.expires_on_utc }}",
    "hosts_imported": {% if metrics.subscription_details.hosts_imported is string %}"{{ metrics.subscription_details.hosts_imported }}"{% else %}{{ metrics.subscription_details.hosts_imported }}{% endif %},
    "active_hosts_previously_deleted": {% if metrics.subscription_details.active_hosts_previously_deleted is string %}"{{ metrics.subscription_details.active_hosts_previously_deleted }}"{% else %}{{ metrics.subscription_details.active_hosts_previously_deleted }}{% endif %},
    "trial": "{{ metrics.subscription_details.trial }}",
    "days_remaining": {% if metrics.subscription_details.days_remaining is not none %}{{ metrics.subscription_details.days_remaining }}{% else %}null{% endif %}
  },
{% endif %}
  "organizations": [
{% for org in metrics.organizations %}
    {
      "name": "{{ org.name }}",
      "max_nodes": {% if org.max_hosts is none %}null{% elif org.max_hosts == 0 %}"Unlimited"{% else %}{{ org.max_hosts }}{% endif %},
      "total_nodes": {{ org.total_nodes }},
      "total_nodes_pct": {{ org.total_nodes_pct }},
      "unique_nodes": {{ org.unique_nodes }},
      "unique_nodes_pct": {{ org.unique_nodes_pct }},
      "shared_nodes": {% if org.shared_nodes is none %}null{% else %}{{ org.shared_nodes }}{% endif %},
      "shared_nodes_pct": {% if org.shared_nodes is none %}null{% else %}{{ org.shared_nodes_pct }}{% endif %},
      "unique_licenses": {{ org.unique_licenses }},
      "unique_licenses_pct": {{ org.unique_licenses_pct }},
      "shared_licenses": {% if org.shared_licenses is none %}null{% else %}{{ org.shared_licenses }}{% endif %},
      "shared_licenses_pct": {% if org.shared_licenses is none %}null{% else %}{{ org.shared_licenses_pct }}{% endif %}

    }{% if not loop.last %},
{% endif %}
{% endfor %}
  ],
{% if show_node_details | default(true) | bool %}
  "nodes_with_organizations": [
{% set ns = namespace(first_with_orgs=true) %}
{% for node in metrics.nodes %}
{% set has_orgs = node.organizations is defined and node.organizations is not none and (node.organizations | length) > 0 %}
{% if has_orgs %}
{% if not ns.first_with_orgs %},
{% endif %}
    {
      "nodename": "{{ node.nodename }}",
      "license": {{ node.license | lower }},
      "organizations": [{% for org_id in node.organizations %}{{ org_id }}{% if not loop.last %}, {% endif %}{% endfor %}]
    }
{% set ns.first_with_orgs = false %}
{% endif %}
{% endfor %}
  ],
  "orphaned_nodes": [
{% set ns = namespace(first_orphan=true) %}
{% for node in metrics.nodes %}
{% set has_orgs = node.organizations is defined and node.organizations is not none and (node.organizations | length) > 0 %}
{% if not has_orgs %}
{% if not ns.first_orphan %},
{% endif %}
    {
      "nodename": "{{ node.nodename }}",
      "license": {{ node.license | lower }},
      "organizations": []
    }
{% set ns.first_orphan = false %}
{% endif %}
{% endfor %}
  ],
{% endif %}
  "organization_names": {
{% for org_id, org_name in metrics.organization_names.items() %}
    "{{ org_id }}": "{{ org_name }}"{% if not loop.last %},
{% endif %}
{% endfor %}
  }
}
