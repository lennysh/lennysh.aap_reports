---
report:
  title: "Ansible Automation Platform Node Metrics Report"
  aap_url: "{{ metrics.aap_url }}"
  generated_at: "{{ metrics.generated_at }}"
{% if metrics.subscription_details is defined and metrics.subscription_details %}

subscription_details:
  status: "{{ metrics.subscription_details.status }}"
  status_description: "{{ metrics.subscription_details.status_description }}"
  hosts_remaining: {{ metrics.subscription_details.hosts_remaining }}
  subscription_type: "{{ metrics.subscription_details.subscription_type }}"
  expires_on: "{{ metrics.subscription_details.expires_on }}"
  automation_controller_version: "{{ metrics.subscription_details.automation_controller_version }}"
  hosts_automated: "{{ metrics.subscription_details.hosts_automated }}"
  hosts_deleted: "{{ metrics.subscription_details.hosts_deleted }}"
  subscription_sku: "{{ metrics.subscription_details.subscription_sku }}"
  expires_on_utc: "{{ metrics.subscription_details.expires_on_utc }}"
  hosts_imported: {{ metrics.subscription_details.hosts_imported }}
  active_hosts_previously_deleted: "{{ metrics.subscription_details.active_hosts_previously_deleted }}"
  trial: "{{ metrics.subscription_details.trial }}"
  days_remaining: {{ metrics.subscription_details.days_remaining if metrics.subscription_details.days_remaining is not none else 'null' }}

{% endif %}
organizations:
{% for org in metrics.organizations %}
  - name: "{{ org.name }}"
    max_nodes: {% if org.max_hosts is none %}null{% elif org.max_hosts == 0 %}"Unlimited"{% else %}{{ org.max_hosts }}{% endif %}

    total_nodes: {{ org.total_nodes }}
    total_nodes_pct: {{ org.total_nodes_pct }}
    unique_nodes: {{ org.unique_nodes }}
    unique_nodes_pct: {{ org.unique_nodes_pct }}
{% if org.shared_nodes is none %}
    shared_nodes: null
    shared_nodes_pct: null
{% else %}
    shared_nodes: {{ org.shared_nodes }}
    shared_nodes_pct: {{ org.shared_nodes_pct }}
{% endif %}
    unique_licenses: {{ org.unique_licenses }}
    unique_licenses_pct: {{ org.unique_licenses_pct }}
{% if org.shared_licenses is none %}
    shared_licenses: null
    shared_licenses_pct: null
{% else %}
    shared_licenses: {{ org.shared_licenses }}
    shared_licenses_pct: {{ org.shared_licenses_pct }}
{% endif %}
{% endfor %}
{% if show_node_details | default(true) | bool %}

nodes_with_organizations:
{% for node in metrics.nodes %}
{% set has_orgs = node.organizations is defined and node.organizations is not none and (node.organizations | length) > 0 %}
{% if has_orgs %}
  - nodename: "{{ node.nodename }}"
    license: {{ node.license | lower }}
    organizations:
{% for org_id in node.organizations %}
      - {{ org_id }}
{% endfor %}
{% endif %}
{% endfor %}

orphaned_nodes:
{% for node in metrics.nodes %}
{% set has_orgs = node.organizations is defined and node.organizations is not none and (node.organizations | length) > 0 %}
{% if not has_orgs %}
  - nodename: "{{ node.nodename }}"
    license: {{ node.license | lower }}
    organizations: []
{% endif %}
{% endfor %}
{% endif %}

organization_names:
{% for org_id, org_name in metrics.organization_names.items() %}
  "{{ org_id }}": "{{ org_name }}"
{% endfor %}
...
